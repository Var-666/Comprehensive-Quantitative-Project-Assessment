# development/test 可使用模拟样本；所有环境均强制登录和项目授权。
APP_ENV=development
DEMO_MODE=true
BUSINESS_TIMEZONE=Asia/Shanghai
# 留空不填写此项时，默认使用仓库根目录 development.db。
# DATABASE_URL=sqlite:////absolute/path/to/development.db
# PostgreSQL 本机方案（密码由本地环境提供；不要提交 .env）
# DATABASE_URL=postgresql+psycopg://project_eval:YOUR_LOCAL_PASSWORD@127.0.0.1:5432/project_eval
POSTGRES_USER=project_eval
POSTGRES_DB=project_eval
POSTGRES_PASSWORD=
# 2026-10-20已确认：导入遇错整批回滚，部分成功模式禁用。
SESSION_HOURS=8
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:8001
# production要求DEMO_MODE=false、PostgreSQL与HTTPS Secure Cookie。
