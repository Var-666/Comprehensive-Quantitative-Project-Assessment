# development/test 可使用模拟样本；所有环境均强制登录和项目授权。
APP_ENV=development
DEMO_MODE=true
BUSINESS_TIMEZONE=Asia/Shanghai
# 留空不填写此项时，默认使用仓库根目录 development.db。
# DATABASE_URL=sqlite:////absolute/path/to/development.db
# PostgreSQL 本机方案（密码由本地环境提供；不要提交 .env）
# DATABASE_URL=postgresql+psycopg://project_eval:YOUR_LOCAL_PASSWORD@127.0.0.1:5432/project_eval
POSTGRES_USER=project_eval
POSTGRES_DB=project_eval
POSTGRES_PASSWORD=
# 2026-10-20已确认：导入遇错整批回滚，部分成功模式禁用。
SESSION_HOURS=8
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:8001
# production要求DEMO_MODE=false、PostgreSQL与HTTPS Secure Cookie。

# 第三阶段：默认不联网。真实模式须部署允许且每次显式同意外送。
AI_PROVIDER=mock
# AI_PROVIDER=openai_compatible
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
AI_EXTERNAL_ENABLED=false
AI_TIMEOUT_SECONDS=20

# 大模型配置由数据库中的管理员配置优先；移除Web Key后不回退环境Key。
# 本机可运行 .venv/bin/python scripts/init_llm_security.py，生成0600主密钥文件引用。
LLM_ENCRYPTION_KEY_FILE=
# 生产可由部署Secret注入 LLM_ENCRYPTION_KEY（Fernet格式），不写真实API Key到文件。
LLM_ENCRYPTION_KEY=
# 允许的精确HTTPS origin，逗号分隔；端口默认443。不包含/v1路径。
LLM_ALLOWED_ORIGINS=https://maas-api.cmhk.com
# 若上述已授权企业域名解析到专用内网，还须显式列入本项；回环/元数据地址始终禁止。
LLM_PRIVATE_ORIGINS=
# 默认禁止HTTP提交Key；scripts/dev.sh按用户要求仅为本机开发入口启用，生产始终拒绝。
LLM_ALLOW_LOCAL_HTTP_CREDENTIALS=false
